{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deal-buster-agent",
  "main": "worker/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  // The web chat, built by `bun run web:build` (vite.web.config.ts) and served at
  // /. `bun run predeploy` builds it, so a deploy can never ship a stale or
  // missing bundle — that is what made the deployed root 404.
  //
  // run_worker_first lists the paths that must reach the Worker even though
  // static assets are matched first: the agent's WebSocket and HTTP routes, the
  // MCP OAuth callback, and the dev price-check trigger.
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/web",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/oauth/*", "/dev/*"]
  },
  // The workflow shares this Worker's bindings, so it gets AI, DealScout and the
  // Resend secrets without any extra wiring.
  "workflows": [
    {
      "binding": "PRICE_CHECK_WORKFLOW",
      "name": "price-check",
      "class_name": "PriceCheckWorkflow"
    }
  ],
  // Non-secret defaults only. RESEND_API_KEY, NOTIFY_EMAIL and DEV_TRIGGER_TOKEN
  // come from .dev.vars locally and `wrangler secret put` in production — never
  // from this file.
  "vars": {
    "RESEND_FROM": "onboarding@resend.dev"
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "DealScout",
        "name": "DealScout"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["DealScout"],
      "tag": "v1"
    }
  ]
}
