{
  // Worker project: the DealScout Durable Object plus the web-chat fallback UI.
  // Its JSX resolves to plain React (the TUI's resolves to @opentui/react), and
  // its globals come from worker/env.d.ts — generated by `bun run agent:types`.
  "extends": "agents/tsconfig",
  "compilerOptions": {
    // Runtime types come from `wrangler types` (worker/env.d.ts), not the
    // @cloudflare/workers-types package.
    "types": [
      "node",
      "vite/client"
    ]
  },
  // src/api and src/types are shared with the TUI, so they must stay
  // isomorphic: fetch/URLSearchParams only, nothing Bun- or workerd-specific.
  "include": [
    "worker/**/*.ts",
    "worker/**/*.tsx",
    "worker/env.d.ts",
    "src/api/**/*.ts",
    "src/types/**/*.ts",
    "src/mapGameDetails.ts",
    "vite.config.ts",
    "vite.web.config.ts"
  ]
}
