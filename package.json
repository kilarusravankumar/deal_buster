{
  "name": "deal_buster",
  "module": "index.tsx",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run index.tsx",
    "dev": "bun --hot index.tsx",
    "dev:local": "bun --hot index.tsx --local",
    "agent:dev": "wrangler dev --port 8787",
    "agent:deploy": "bun run deploy",
    "agent:types": "wrangler types worker/env.d.ts",
    "web:dev": "vite dev",
    "web:build": "vite build -c vite.web.config.ts",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "predeploy": "bun run web:build",
    "deploy": "wrangler deploy",
    "build:tui": "bun build --compile index.tsx --outfile deal-buster"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@cloudflare/vite-plugin": "^1.46.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.1",
    "@types/bun": "latest",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "wrangler": "^4.113.0"
  },
  "dependencies": {
    "@cloudflare/ai-chat": "0.9.3",
    "@cloudflare/kumo": "^2.6.0",
    "@opentui/core": "^0.5.6",
    "@opentui/keymap": "^0.5.6",
    "@opentui/react": "^0.5.6",
    "@phosphor-icons/react": "^2.1.10",
    "@streamdown/code": "^1.1.1",
    "agents": "^0.17.4",
    "ai": "^6.0.197",
    "react": "^19.2.8",
    "react-dom": "^19.2.7",
    "streamdown": "^2.5.0",
    "turndown": "^7.2.4",
    "workers-ai-provider": "^3.2.1",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "core-js-pure@3.49.0": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260721.1": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true
  }
}
